# `node scripts/setup.mjs` (or `docker compose run --rm setup`) copies this to
# .env and fills in fresh secrets. Never commit .env. To fill it by hand,
# generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# What the agents run on until you save Settings: claude_code (your Claude
# Pro or Max plan), codex (your ChatGPT plan), claude_api or openai_api (your
# own key, paid per call). Setup asks. Left empty, the app picks the first
# one below it has a sign-in for.
AGENT_ENGINE=

# Claude Code on your own Claude plan: the token `claude setup-token` prints.
# Codex signs in from Settings instead. In Docker they run in the app's
# container, in an empty folder for each step; on Vercel, in a Vercel Sandbox.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional API keys. With the Claude API or the OpenAI API picked, steps run
# on it. With a plan picked, a step the plan can't run, for example at its
# usage limit, runs on the Claude API, else on the OpenAI API, within the
# monthly budget. With neither key, it waits for the next try.
# Claude API (https://platform.claude.com)
ANTHROPIC_API_KEY=
# OpenAI API (https://platform.openai.com). A key saved in Settings wins.
OPENAI_API_KEY=

# Your time zone isn't set here: the app takes it from your browser when you
# finish setting it up, and Settings changes it.

# The port the app runs on. When another program has 3000, setup picks the
# next free one and sets it here and in BETTER_AUTH_URL. Start the dev server
# with `pnpm dev --port <port>` then. DB_PORT (5432) and INNGEST_PORT (8288)
# move the same way, when they have to.
APP_PORT=3000

# Auth (Better Auth). The app has one account: the first sign-up creates it,
# with the setup code that comes from BETTER_AUTH_SECRET (setup prints it, and
# the app logs it while no account exists). Keep the secret: it also encrypts
# the keys you save in Settings.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Database (compose `db` service; the app on your machine connects via localhost)
POSTGRES_PASSWORD=jobagent
DATABASE_URL=postgres://jobagent:jobagent@localhost:5432/jobagent
# On Vercel, Neon sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED, which
# migrations use when it's set.

# Inngest
# Local development with the Dev Server:
INNGEST_DEV=1
# Self-hosted (`--profile app`) or Inngest Cloud: hex strings, even length
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# File storage: local | vercel-blob (private blobs; Vercel sets the token when
# a Blob store is connected to the project)
STORAGE_DRIVER=local
STORAGE_DIR=./.data/files
# BLOB_READ_WRITE_TOKEN=

# Cost guardrails (USD) for paid API calls; a plan's agent costs $0. A search
# run stops at RUN_BUDGET_USD and every API call stops once the month's spend
# reaches MONTHLY_BUDGET_USD. Saved Settings override these.
MONTHLY_BUDGET_USD=20
RUN_BUDGET_USD=1
