{
  "name": "job-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "smoke": "playwright test --config e2e/playwright.config.ts",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
