    "@react-pdf/renderer": "^4.9.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-table": "^9.3.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.5",
    "@vercel/sandbox": "^3.9.1",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "1.0.0-rc.4",
    "inngest": "^4.26.2",
